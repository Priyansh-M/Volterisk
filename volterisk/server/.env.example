# Real values live in volterisk/server/.env on your PC. That file is gitignored.
# Vercel does not read it. Copy DATABASE_URL, DIRECT_URL, and JWT_SECRET into the
# Vercel project (Production and Preview) before the first deploy.
#
# Local SQLite play uses a file URL instead of Supabase:
# DATABASE_URL="file:./data/dev.db"
#
# Supabase (`npm run db:push:supabase` and the live site):
# DATABASE_URL is the transaction pooler, port 6543, with pgbouncer=true and connection_limit=1.
# DIRECT_URL is the session pooler, port 5432, with no pgbouncer.
# Encode a password that contains @ as %40.

DATABASE_URL="file:./data/dev.db"
DIRECT_URL=""
JWT_SECRET="replace-with-a-long-random-string"
PORT=8787
