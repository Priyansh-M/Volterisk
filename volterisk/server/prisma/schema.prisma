generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id               String    @id @default(cuid())
  username         String
  usernameKey      String    @unique
  avatarUrl        String?
  passwordHash     String
  cash             Int
  tokenVersion     Int       @default(0)
  isBot            Boolean   @default(false)
  cameraLevel      Int       @default(0)
  passiveJobId     String?
  passivePaidFor   DateTime?
  reputationLevel  Int       @default(1)
  /** Set when a reputation rung is claimed — heist conditions count only after this. */
  reputationClaimedAt DateTime?
  vaultExposedUntil DateTime?
  heat             Int       @default(0)
  heatSettledAt    DateTime  @default(now())
  heatJudgedOn     String?
  starterClaimedAt DateTime?
  rouletteDay      String?
  rouletteStaked   Int       @default(0)
  rouletteCap      Int       @default(0)
  policeAttention  Int       @default(0)
  policeSettledOn  String?
  vaultCreditCard  Boolean   @default(false)
  lastVaultYieldAt DateTime?
  primaryCareer    String?
  secondaryCareer  String?
  careerChangedAt  DateTime?
  createdAt        DateTime  @default(now())

  vault             Vault?
  base              Base?
  weapons           UserWeapon[]
  properties        Property[]
  contracts         ContractRun[]
  achievements      UserAchievement[]
  heistsAttacked    Heist[]              @relation("HeistAttacker")
  heistsDefended    Heist[]              @relation("HeistTarget")
  notifications     Notification[]
  txFrom            Transaction[]        @relation("TxFrom")
  txTo              Transaction[]        @relation("TxTo")
  inventory         InventoryItem[]
  bountiesPosted    Bounty[]             @relation("BountyPoster")
  bountiesOn        Bounty[]             @relation("BountyTarget")
  bountiesHunted    Bounty[]             @relation("BountyHunter")
  bountyFunds       BountyFund[]
  bountyCuts        BountyCut[]
  territoryHoldings TerritoryHolding[]
  expansionOps      ExpansionOp[]
  modsOwned         ModOwned[]
  craftJobs         CraftingJob[]
  craftLedger       CraftLedger[]
  reputationCredits ReputationCredit[]
  marketListings    MarketListing[]     @relation("MarketSeller")
  marketPurchases   MarketListing[]     @relation("MarketBuyer")
}

model CraftingJob {
  id          String    @id @default(cuid())
  userId      String
  recipeId    String
  startsAt    DateTime  @default(now())
  completesAt DateTime
  collectedAt DateTime?
  cancelledAt DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, collectedAt, cancelledAt])
}

/** Lifetime workshop crafts per mod — used by reputation craft conditions. */
model CraftLedger {
  id        String   @id @default(cuid())
  userId    String
  modId     String
  count     Int      @default(0)
  firstAt   DateTime @default(now())
  lastAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, modId])
  @@index([userId])
}

/**
 * Lifetime reputation condition credits (assets, vault money, crafts, etc.).
 * Heists are never stored — those reset every claimed level.
 */
model ReputationCredit {
  id        String   @id @default(cuid())
  userId    String
  key       String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, key])
  @@index([userId])
}

/** P2P Black Market. kind: material | weapon | mod. status: open | sold | cancelled | expired */
model MarketListing {
  id              String    @id @default(cuid())
  sellerId        String
  buyerId         String?
  kind            String
  itemId          String
  quantity        Int       @default(1)
  price           Int
  status          String    @default("open")
  userWeaponId    String?
  modOwnedId      String?
  expiresAt       DateTime
  soldAt          DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime  @default(now())

  seller User @relation("MarketSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  buyer  User? @relation("MarketBuyer", fields: [buyerId], references: [id], onDelete: SetNull)

  @@index([status, expiresAt])
  @@index([sellerId, status])
  @@index([kind, status])
}

/** Extra sectors beyond the original Base. sectorId unique across all players. */
model TerritoryHolding {
  id             String   @id @default(cuid())
  userId         String
  sectorId       String   @unique
  landmassId     String
  regionName     String
  specialization String?
  /** Custom map fill hex from Sector Pigment Kit (null = default purple). */
  mapColor       String?
  securedAt      DateTime @default(now())
  createdAt      DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([landmassId])
}

/** Multi-step expansion: scout → select → prepare → secure → claim. */
model ExpansionOp {
  id          String    @id @default(cuid())
  userId      String
  sectorId    String
  landmassId  String
  regionName  String
  stage       String
  completesAt DateTime?
  closedAt    DateTime?
  createdAt   DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, closedAt])
  @@index([sectorId])
}

/**
 * One claimed map sector per player. sectorId is unique, so two players cannot
 * hold the same sector even under concurrent claims.
 */
model Base {
  id         String   @id @default(cuid())
  userId     String   @unique
  sectorId   String   @unique
  landmassId String
  regionName String
  name       String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([landmassId])
}

/**
 * An owned asset with a level and storage capacity. No passive income.
 */
model Property {
  id         String   @id @default(cuid())
  userId     String
  catalogId  String
  level      Int      @default(1)
  sectorId   String?
  regionName String?
  createdAt  DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

/**
 * One accepted work-board contract. Reward is stamped from rules.ts at accept time.
 * activeSlot is the user id while the job is uncollected, and null after payout.
 * The unique index is what keeps a player to a single active contract.
 */
model ContractRun {
  id              String    @id @default(cuid())
  userId          String
  contractId      String
  reward          Int
  acceptedAt      DateTime  @default(now())
  completesAt     DateTime
  collectedAt     DateTime?
  readyNotifiedAt DateTime?
  activeSlot      String?   @unique

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, collectedAt])
  @@index([userId, contractId, collectedAt])
}

model UserAchievement {
  id            String    @id @default(cuid())
  userId        String
  achievementId String
  unlockedAt    DateTime  @default(now())
  announcedAt   DateTime?
  claimedAt     DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
}

model InventoryItem {
  id       String @id @default(cuid())
  userId   String
  itemId   String
  quantity Int

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, itemId])
}

model NpcPurse {
  id             String   @id @default(cuid())
  attackerId     String
  npcId          String
  weekStart      DateTime
  balance        Int
  defaultBalance Int
  vaultTier      String
  vaultLevel     Int

  @@unique([attackerId, npcId, weekStart])
  @@index([attackerId, weekStart])
}

model Vault {
  id            String    @id @default(cuid())
  userId        String    @unique
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  balance       Int
  level         Int
  tier          String    @default("standard")
  insured       Boolean   @default(false)
  insuredUntil  DateTime?
  breached      Boolean   @default(false)
}

model Weapon {
  id     String       @id
  name   String
  number Int          @unique
  owners UserWeapon[]
  heists Heist[]
}

model UserWeapon {
  id             String  @id @default(cuid())
  userId         String
  weaponId       String
  upgradeLevel   Int
  durability     Int     @default(50)
  maxDurability  Int     @default(50)
  equipped       Boolean @default(false)
  listed         Boolean @default(false)
  user           User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  weapon         Weapon  @relation(fields: [weaponId], references: [id])
  mods           ModOwned[]

  @@index([userId, weaponId])
  @@index([userId, equipped])
}

/**
 * Owned modification instance. status: inventory | installed | listed
 * kind: weapon | vault. Installed weapon mods set userWeaponId.
 * Installed vault mods set vaultSlot (>=0). Emergency Lockdown uses activatedAt.
 */
model ModOwned {
  id           String    @id @default(cuid())
  userId       String
  modId        String
  kind         String
  status       String    @default("inventory")
  userWeaponId String?
  vaultSlot    Int?
  activatedAt  DateTime?
  createdAt    DateTime  @default(now())

  user       User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  userWeapon UserWeapon? @relation(fields: [userWeaponId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, modId])
  @@index([userWeaponId])
}

model Heist {
  id            String   @id @default(cuid())
  attackerId    String
  targetId      String
  weaponId      String
  weaponLevel   Int
  vaultLevel    Int
  successChance Int
  success       Boolean
  amountStolen  Int
  createdAt     DateTime @default(now())

  attacker     User          @relation("HeistAttacker", fields: [attackerId], references: [id])
  target       User          @relation("HeistTarget", fields: [targetId], references: [id])
  weapon       Weapon        @relation(fields: [weaponId], references: [id])
  transaction  Transaction?
  notification Notification?

  @@index([attackerId, createdAt])
  @@index([targetId, success, createdAt])
}

model EconomySnapshot {
  id         String   @id @default(cuid())
  takenAt    DateTime @default(now())
  totalMoney Int
  heisted    Int
  players    Int
}

model Transaction {
  id         String   @id @default(cuid())
  type       String
  amount     Int
  fromUserId String?
  toUserId   String?
  heistId    String?  @unique
  createdAt  DateTime @default(now())

  fromUser User?  @relation("TxFrom", fields: [fromUserId], references: [id])
  toUser   User?  @relation("TxTo", fields: [toUserId], references: [id])
  heist    Heist? @relation(fields: [heistId], references: [id])

  @@index([createdAt])
}

model RouletteLobby {
  id         String    @id @default(cuid())
  hostId     String
  createdAt  DateTime  @default(now())
  lastNumber String?
  lastSpinAt DateTime?
  spinToken  Int       @default(0)

  seats   RouletteSeat[]
  invites RouletteInvite[]
}

model RouletteSeat {
  id         String @id @default(cuid())
  lobbyId    String
  userId     String @unique
  betsJson   String @default("[]")
  resultJson String @default("")

  lobby RouletteLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, userId])
}

model RouletteInvite {
  id        String   @id @default(cuid())
  lobbyId   String
  fromId    String
  toId      String
  status    String   @default("pending")
  createdAt DateTime @default(now())

  lobby RouletteLobby @relation(fields: [lobbyId], references: [id], onDelete: Cascade)

  @@unique([lobbyId, toId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  heistId   String?  @unique
  title     String
  body      String
  severity  String   @default("INFO")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  heist Heist? @relation(fields: [heistId], references: [id])

  @@index([userId, createdAt])
}

/**
 * Shared contract on a mark. amount = remaining reward pool.
 * funded = goal = steal target (the posted reward is also how much must be stolen).
 * Hunters must Start before their heists count. Payout settles on complete/cancel.
 * status: open | hunting | completed | cancelled
 */
model Bounty {
  id            String    @id @default(cuid())
  posterId      String
  targetId      String
  amount        Int
  funded        Int       @default(0)
  goal          Int       @default(0)
  stolenTotal   Int       @default(0)
  status        String    @default("open")
  hunterId      String?
  huntStartedAt DateTime?
  heistId       String?
  claimedAt     DateTime?
  cancelledAt   DateTime?
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  poster User         @relation("BountyPoster", fields: [posterId], references: [id], onDelete: Cascade)
  target User         @relation("BountyTarget", fields: [targetId], references: [id], onDelete: Cascade)
  hunter User?        @relation("BountyHunter", fields: [hunterId], references: [id], onDelete: SetNull)
  funds  BountyFund[]
  cuts   BountyCut[]

  @@index([status, createdAt])
  @@index([posterId, targetId, status])
  @@index([hunterId, status])
  @@index([targetId, status])
}

model BountyFund {
  id        String   @id @default(cuid())
  bountyId  String
  userId    String
  amount    Int
  createdAt DateTime @default(now())

  bounty Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([bountyId])
  @@index([userId])
}

/** Hunter enrollment. Heists only count after Start. */
model BountyCut {
  id        String   @id @default(cuid())
  bountyId  String
  userId    String
  stolen    Int      @default(0)
  paid      Int      @default(0)
  startedAt DateTime @default(now())

  bounty Bounty @relation(fields: [bountyId], references: [id], onDelete: Cascade)
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([bountyId, userId])
  @@index([userId])
}
